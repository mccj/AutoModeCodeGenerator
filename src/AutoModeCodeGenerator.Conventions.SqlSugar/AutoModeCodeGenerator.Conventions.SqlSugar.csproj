<Project Sdk="Microsoft.NET.Sdk">
  <!--
    可选约定包：仅含字符串常量与 mixin 示例，不引用 SqlSugar 程序集。
    主分析器包保持 ORM 无关；本包供复制或 PackageReference。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <Version>1.0.1.0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>AutoModeCodeGenerator.Conventions.SqlSugar</PackageId>
    <Description>Optional SqlSugar-oriented string templates and mixin snippets for AutoModeCodeGenerator. No SqlSugar assembly dependency.</Description>
    <Authors>mccj</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
