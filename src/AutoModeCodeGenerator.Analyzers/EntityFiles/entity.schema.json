{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mccj/AutoModeCodeGenerator/entity.schema.json",
  "title": "AutoModeCodeGenerator entity.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "namespace": { "type": "string" },
    "className": { "type": "string" },
    "nullable": {
      "type": "string",
      "enum": [
        "enable",
        "disable",
        "restore",
        "enable warnings",
        "disable warnings",
        "restore warnings",
        "enable annotations",
        "disable annotations",
        "restore annotations"
      ]
    },
    "classStyle": { "type": "string", "enum": ["Poco", "Record", "Inpc", "poco", "record", "inpc"] },
    "modifier": {
      "type": "string",
      "enum": ["public", "internal", "protected", "private", "protected internal", "private protected"]
    },
    "isAbstract": { "type": "boolean" },
    "isPartial": { "type": "boolean" },
    "prefix": { "type": "string" },
    "suffix": { "type": "string" },
    "summary": { "type": "string" },
    "remarks": { "type": "string" },
    "example": { "type": "string" },
    "inherit": { "type": "string" },
    "inheritAttribute": { "type": "boolean" },
    "toNullable": { "type": "boolean" },
    "usings": { "type": "array", "items": { "type": "string" } },
    "interfaces": { "type": "array", "items": { "type": "string" } },
    "attributes": { "type": "array", "items": { "type": "string" } },
    "modes": {
      "type": "array",
      "description": "多模式定义；省略时使用根级单类配置",
      "items": { "$ref": "#/$defs/mode" }
    },
    "properties": {
      "type": "array",
      "items": { "$ref": "#/$defs/property" }
    }
  },
  "$defs": {
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "namespace": { "type": "string" },
        "className": { "type": "string" },
        "classStyle": { "type": "string", "enum": ["Poco", "Record", "Inpc", "poco", "record", "inpc"] },
        "modifier": {
          "type": "string",
          "enum": ["public", "internal", "protected", "private", "protected internal", "private protected"]
        },
        "isAbstract": { "type": "boolean" },
        "isPartial": { "type": "boolean" },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "summary": { "type": "string" },
        "remarks": { "type": "string" },
        "example": { "type": "string" },
        "inherit": { "type": "string" },
        "inheritAttribute": { "type": "boolean" },
        "toNullable": { "type": "boolean" },
        "usings": { "type": "array", "items": { "type": "string" } },
        "interfaces": { "type": "array", "items": { "type": "string" } },
        "attributes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "id": { "type": "string", "description": "绑定的单个 mode id" },
        "ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "绑定的多个 mode id"
        },
        "prefix": { "type": "string" },
        "suffix": { "type": "string" },
        "modifier": {
          "type": "string",
          "enum": ["public", "internal", "protected", "private", "protected internal", "private protected"]
        },
        "isNullable": { "type": "boolean" },
        "isVirtual": { "type": "boolean" },
        "isOverride": { "type": "boolean" },
        "isNew": { "type": "boolean" },
        "isInit": { "type": "boolean" },
        "isRequired": { "type": "boolean" },
        "defaultValue": { "type": "string" },
        "summary": { "type": "string" },
        "remarks": { "type": "string" },
        "example": { "type": "string" },
        "attributes": { "type": "array", "items": { "type": "string" } },
        "inheritAttributes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
