<Project>
	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

		<!-- NuGet 包标识与展示信息（发包流程见 PACKAGING.md） -->
		<PackageId>AutoModeCodeGenerator.Analyzers</PackageId>
		<Authors>mccj</Authors>
		<Title>AutoModeCodeGenerator Analyzers</Title>
		<Description>基于 Roslyn 的 C# 增量源生成器：特性驱动 CRUD 多产物，或从 .entity.json 声明式生成 POCO/Record/INPC。Roslyn incremental source generator: attribute-driven CRUD multi-output types and/or .entity.json declarative generation.</Description>
		<PackageTags>roslyn;source-generator;analyzer;code-generation;poco;record;inpc;incremental-generator;csharp</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/mccj/AutoModeCodeGenerator</PackageProjectUrl>
		<RepositoryUrl>https://github.com/mccj/AutoModeCodeGenerator.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>
	
	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="EntityFiles\entity.schema.json">
			<Pack>True</Pack>
			<PackagePath>content\entity.schema.json</PackagePath>
		</None>
		<None Include="build\AutoModeCodeGenerator.Analyzers.props">
			<Pack>True</Pack>
			<PackagePath>build\</PackagePath>
		</None>
	</ItemGroup>
</Project>